{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/private-cloud-music-player/album-manifest.schema.json",
  "title": "Album Import Manifest",
  "type": "object",
  "required": ["artist", "album", "tracks"],
  "properties": {
    "artist": { "type": "string", "minLength": 1 },
    "album": { "type": "string", "minLength": 1 },
    "year": { "type": ["integer", "null"], "minimum": 1877 },
    "genre": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["fileName", "title", "trackNumber", "sha256", "sizeBytes"],
        "properties": {
          "fileName": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "trackNumber": { "type": "integer", "minimum": 1 },
          "discNumber": { "type": "integer", "minimum": 1, "default": 1 },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "sizeBytes": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
